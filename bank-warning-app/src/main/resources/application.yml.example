# ============================================================
# 长江河岸崩塌风险评估系统 - 配置文件模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 application.yml
# 2. 修改下面的配置项（特别是敏感信息）
# 3. application.yml 不会提交到 Git
# ============================================================

server:
  port: 8090

spring:
  application:
    name: bank-warning-server
  datasource:
    url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
    username: ${BANK_DB_USERNAME:postgres}
    password: ${BANK_DB_PASSWORD:123456}
    driver-class-name: org.postgresql.Driver

  servlet:
    multipart:
      max-file-size: 2GB
      max-request-size: 2GB

  # Kafka 配置（可选）
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:127.0.0.1:9092}
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
      acks: all
      retries: 10
      properties:
        enable.idempotence: true
        max.in.flight.requests.per.connection: 5
        delivery.timeout.ms: 120000
        request.timeout.ms: 30000
    consumer:
      group-id: ${KAFKA_RESULT_GROUP_ID:bank-warning-result-consumer}
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      auto-offset-reset: earliest
      enable-auto-commit: false
      properties:
        spring.json.trusted.packages: com.yangtze.bankwarning.dto.kafka
        isolation.level: read_committed
    listener:
      ack-mode: manual
      concurrency: 2

# AgentScope 多智能体配置
agentscope:
  openai:
    # 【必填】DeepSeek API Key
    api-key: ${DEEPSEEK_API_KEY:}
    # DeepSeek API 地址
    base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com}
    # 使用的模型
    model-name: ${DEEPSEEK_MODEL:deepseek-chat}
  dashscope:
    # 【选填】DashScope API Key（用于文本嵌入，不填则仅用关键词检索）
    api-key: ${DASHSCOPE_API_KEY:}
    # 嵌入模型
    embedding-model-name: text-embedding-v3
    # 嵌入向量维度
    embedding-dimensions: 1024
  vector:
    # 向量维度（需与 dashscope.embedding-dimensions 一致）
    dimensions: 1024
    # pgvector 持久化配置（默认复用主数据源配置）
    pgvector:
      jdbc-url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
      username: ${BANK_DB_USERNAME:postgres}
      password: ${BANK_DB_PASSWORD:123456}
      schema: public
      table-name: ai_knowledge_store
  # Nacos Skill Registry（3.2+ 提供 Skill 管理中心；关闭时仅使用本地 SKILL.md）
  nacos:
    # 是否启用 Nacos Skill 自动下载与发布
    enabled: ${NACOS_ENABLED:false}
    # Nacos 服务器地址
    server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
    # 命名空间
    namespace: ${NACOS_NAMESPACE:public}
    # 鉴权（如果开启了 Nacos 鉴权）
    username: ${NACOS_USERNAME:}
    password: ${NACOS_PASSWORD:}

# 天气 API（和风天气，免费注册 https://dev.qweather.com）
qweather:
  # 【选填】和风天气 API Key
  api-key: ${QWEATHER_API_KEY:}
  base-url: https://devapi.qweather.com/v7
  geo-url: https://geoapi.qweather.com/v2
  cache-ttl-minutes: 30

# 自定义应用配置
app:
  model-service:
    base-url: http://localhost:8088
    default-model-api: /v0/mi/risk-level
    connect-timeout: 5s
    read-timeout: 600s

  kafka:
    enabled: ${KAFKA_ENABLED:false}
    task-topic: ${KAFKA_TASK_TOPIC:bank.model.task}
    result-topic: ${KAFKA_RESULT_TOPIC:bank.model.result.v1}
    result-dlt-topic: ${KAFKA_RESULT_DLT_TOPIC:bank.model.result.dlt.v1}
    terrain-bucket: ${KAFKA_TERRAIN_BUCKET:yangtze-bank-warning-system}

  # AI 智能体模块配置
  ai:
    skill:
      # Skill 脚本物化缓存根目录（启动时把所有 skill 的 resources 物化到这里）
      # <cache-dir>/<skill-name>/scripts/<file>
      cache-dir: ${user.dir}/.skills-cache
    pdf:
      # 兼容旧路径：仅当 cache 里找不到时回退到这里
      fallback-scripts-dir: ${user.dir}/src/main/resources/skills/pdf/scripts
      # Python 脚本执行超时（秒）
      timeout-seconds: 120
    # 可视化脚本配置
    visualization:
      # 脚本目录（bank-model-server 路径）
      script-dir: ../bank-model-server
      # 可视化输出目录
      output-dir: visualization/output

# MyBatis 配置
mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  type-aliases-package: com.yangtze.bankwarning.domain.po
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
