# ============================================================
# 长江河岸崩塌风险评估系统 - 配置文件模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 application.yml
# 2. 修改下面的配置项（特别是敏感信息）
# 3. application.yml 不会提交到 Git
# ============================================================

server:
  port: 8090

spring:
  application:
    name: bank-warning-server
  datasource:
    url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
    username: ${BANK_DB_USERNAME:postgres}
    password: ${BANK_DB_PASSWORD:123456}
    driver-class-name: org.postgresql.Driver

  servlet:
    multipart:
      max-file-size: 2GB
      max-request-size: 2GB

  # Kafka 配置（可选）
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:127.0.0.1:9092}
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
      acks: all
      retries: 10
      properties:
        enable.idempotence: true
        max.in.flight.requests.per.connection: 5
        delivery.timeout.ms: 120000
        request.timeout.ms: 30000
    consumer:
      group-id: ${KAFKA_RESULT_GROUP_ID:bank-warning-result-consumer}
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      auto-offset-reset: earliest
      enable-auto-commit: false
      properties:
        spring.json.trusted.packages: com.yangtze.bankwarning.dto.kafka
        isolation.level: read_committed
    listener:
      ack-mode: manual
      concurrency: 2

# AgentScope 多智能体配置
agentscope:
  openai:
    # 【必填】DeepSeek API Key
    api-key: ${DEEPSEEK_API_KEY:}
    # DeepSeek API 地址
    base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com}
    # 使用的模型
    model-name: ${DEEPSEEK_MODEL:deepseek-chat}
  dashscope:
    # 【选填】DashScope API Key（用于文本嵌入，不填则仅用关键词检索）
    api-key: ${DASHSCOPE_API_KEY:}
    # 嵌入模型
    embedding-model-name: text-embedding-v3
    # 嵌入向量维度
    embedding-dimensions: 1024
  vector:
    # 向量维度（需与 dashscope.embedding-dimensions 一致）
    dimensions: 1024
    # pgvector 持久化配置（默认复用主数据源配置）
    pgvector:
      jdbc-url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
      username: ${BANK_DB_USERNAME:postgres}
      password: ${BANK_DB_PASSWORD:123456}
      schema: public
      table-name: ai_knowledge_store
  # Nacos Skill Registry（3.2+ 提供 Skill 管理中心；关闭时仅使用本地 SKILL.md）
  nacos:
    # 是否启用 Nacos Skill 自动下载与发布
    enabled: ${NACOS_ENABLED:false}
    # Nacos 服务器地址
    server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
    # 命名空间
    namespace: ${NACOS_NAMESPACE:public}
    # 鉴权（如果开启了 Nacos 鉴权）
    username: ${NACOS_USERNAME:}
    password: ${NACOS_PASSWORD:}

# 天气 API（和风天气，免费注册 https://dev.qweather.com）
qweather:
  # 【选填】和风天气 API Key
  api-key: ${QWEATHER_API_KEY:}
  base-url: https://devapi.qweather.com/v7
  geo-url: https://geoapi.qweather.com/v2
  cache-ttl-minutes: 30

# 自定义应用配置
app:
  model-service:
    base-url: http://localhost:8088
    default-model-api: /v0/mi/risk-level
    connect-timeout: 5s
    read-timeout: 600s

  kafka:
    enabled: ${KAFKA_ENABLED:false}
    task-topic: ${KAFKA_TASK_TOPIC:bank.model.task}
    result-topic: ${KAFKA_RESULT_TOPIC:bank.model.result.v1}
    result-dlt-topic: ${KAFKA_RESULT_DLT_TOPIC:bank.model.result.dlt.v1}
    terrain-bucket: ${KAFKA_TERRAIN_BUCKET:yangtze-bank-warning-system}

  # AI 智能体模块配置
  ai:
    skill:
      # Skill 脚本物化缓存根目录（启动时把所有 skill 的 resources 物化到这里）
      # <cache-dir>/<skill-name>/scripts/<file>
      cache-dir: ${user.dir}/.skills-cache
      # Skill 安全校验（阶段一）
      verify:
        # 是否启用完整性校验与静态扫描（关闭时仅保留路径防逃逸）
        enabled: ${SKILL_VERIFY_ENABLED:true}
        # HMAC-SHA256 签名密钥（上传/下载 skill zip 时生成与校验清单用）
        hmac-secret: ${SKILL_HMAC_SECRET:}
        # 静态扫描发现危险 import 时：true=拒绝，false=仅告警
        fail-on-violation: ${SKILL_VERIFY_FAIL_ON_VIOLATION:true}
        # 危险模块黑名单（可覆盖默认值）
        forbidden-imports: [ctypes, multiprocessing, socket, subprocess, urllib, http, ftplib, telnetlib, ftputil, paramiko, shutil]
      # Skill 执行沙箱（阶段二）
      sandbox:
        # off=关闭沙箱（阶段一原行为）；process=进程级软沙箱（默认）；docker=容器级硬沙箱（生产建议）
        mode: ${SKILL_SANDBOX_MODE:process}
        # 单次执行超时（秒），超时后强杀整棵进程树
        timeout-seconds: ${SKILL_SANDBOX_TIMEOUT_SECONDS:120}
        # stdout/stderr 最大捕获字节数，超出部分丢弃并标记截断（防输出洪泛）
        max-output-bytes: ${SKILL_SANDBOX_MAX_OUTPUT_BYTES:1048576}
        # 脚本内存上限（MB，POSIX rlimit；Windows 下降级为仅超时+输出上限）
        memory-mb: ${SKILL_SANDBOX_MEMORY_MB:512}
        # CPU 时间上限（秒，POSIX rlimit）
        cpu-seconds: ${SKILL_SANDBOX_CPU_SECONDS:30}
        # docker 模式：容器内进程数上限 / CPU 配额
        pids-limit: ${SKILL_SANDBOX_PIDS_LIMIT:64}
        cpus: ${SKILL_SANDBOX_CPUS:0.5}
        # docker 模式：镜像名（需预置 Python 及 skill 依赖）
        docker-image: ${SKILL_SANDBOX_DOCKER_IMAGE:}
        # 子进程环境变量白名单（其余一律不继承，防 os.environ 偷取宿主密钥）
        env-allowlist: [PATH, SYSTEMROOT, WINDIR, COMSPEC, PATHEXT, LANG, LC_ALL, PYTHONIOENCODING]
      # Skill 治理闭环（阶段三）
      governance:
        # 是否启用治理（关闭时跳过审批/版本/熔断检查，输出契约校验仍生效）
        enabled: ${SKILL_GOVERNANCE_ENABLED:true}
        # 全局熔断：true 时所有动态 skill 脚本一律拒绝执行
        kill-switch: ${SKILL_GOVERNANCE_KILL_SWITCH:false}
        # 版本批准清单（skill@version），为空表示不限制版本，但仍校验权限审批
        allowed-versions: []
        # 隔离清单（skill@version），命中即拒绝执行（应急下架）
        quarantined-versions: []
        # 权限未审批时：true=拒绝执行，false=仅告警放行（灰度观察期）
        fail-on-unapproved-permission: ${SKILL_GOVERNANCE_FAIL_ON_UNAPPROVED:true}
    pdf:
      # 兼容旧路径：仅当 cache 里找不到时回退到这里
      fallback-scripts-dir: ${user.dir}/src/main/resources/skills/pdf/scripts
    # 可视化脚本配置
    visualization:
      # 脚本目录（bank-model-server 路径）
      script-dir: ../bank-model-server
      # 可视化输出目录
      output-dir: visualization/output

# MyBatis 配置
mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  type-aliases-package: com.yangtze.bankwarning.domain.po
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

# 安全配置
security:
  jwt:
    # 【重要】生产环境必须通过环境变量 JWT_SECRET 设置真实密钥
    # 密钥长度至少32字节（256位），建议使用随机生成的密钥
    # 生成密钥命令：openssl rand -base64 32
    secret: ${JWT_SECRET:}
    expiration: 86400000  # 24小时
    refreshExpiration: 604800000  # 7天
  
  sms:
    enabled: ${SMS_ENABLED:false}
    provider: ${SMS_PROVIDER:aliyun}
    access-key: ${SMS_ACCESS_KEY:}
    access-secret: ${SMS_ACCESS_SECRET:}
    sign-name: ${SMS_SIGN_NAME:长江崩岸预警系统}
    template-code: ${SMS_TEMPLATE_CODE:}

# CORS配置
app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}
