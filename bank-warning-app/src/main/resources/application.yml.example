# ============================================================
# 长江河岸崩塌风险评估系统 - 配置文件模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 application.yml
# 2. 修改下面的配置项（特别是敏感信息）
# 3. application.yml 不会提交到 Git
# ============================================================

server:
  port: 8090

spring:
  application:
    name: bank-warning-server
  datasource:
    url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
    username: ${BANK_DB_USERNAME:postgres}
    password: ${BANK_DB_PASSWORD:123456}
    driver-class-name: org.postgresql.Driver
    hikari:
      # 断面并行计算时，同一时刻会有「多路 × (剖面写入 + 结果写入)」同时要连接。
      # 默认 10 会在 4 路并行下被悄悄占满，表现为并行度打不满、断面耗时变长，
      # 而日志里只有「等待连接」的沉默——这是并行改造最容易漏掉的一环。
      # 上限同时受 PG 的 max_connections（默认 100）约束，20 是安全区间。
      maximum-pool-size: ${DB_POOL_SIZE:20}
      minimum-idle: ${DB_MIN_IDLE:8}
      connection-timeout: ${DB_CONNECTION_TIMEOUT_MS:30000}
  # Redis：只给集群模式的「取消标志」用，默认关闭时不会建立连接
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      timeout: 2s

  servlet:
    multipart:
      max-file-size: 2GB
      max-request-size: 2GB

  # Kafka 配置（可选）
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:127.0.0.1:9092}
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
      acks: all
      retries: 10
      properties:
        enable.idempotence: true
        max.in.flight.requests.per.connection: 5
        delivery.timeout.ms: 120000
        request.timeout.ms: 30000
    consumer:
      group-id: ${KAFKA_RESULT_GROUP_ID:bank-warning-result-consumer}
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      auto-offset-reset: earliest
      enable-auto-commit: false
      properties:
        spring.json.trusted.packages: com.yangtze.bankwarning.dto.kafka
        isolation.level: read_committed
    listener:
      ack-mode: manual
      concurrency: 2

# AgentScope 多智能体配置
# 知识库检索参数（RAG 阶段 1）见本文件下方 app.ai.rag 段。
# ⚠ application.yml 被 gitignore，本模板是唯一进 git 的配置清单，
#   换机要么复制这一段，要么直接用 RAG_* 环境变量覆盖（代码内有安全默认值）。
agentscope:
  openai:
    # 【必填】DeepSeek API Key
    api-key: ${DEEPSEEK_API_KEY:}
    # DeepSeek API 地址
    base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com}
    # 使用的模型（与 application.yml、docker-compose 保持一致）
    model-name: ${DEEPSEEK_MODEL:deepseek-v4-flash}
  dashscope:
    # 【选填】DashScope API Key（用于文本嵌入）。
    # 不填时知识库检索会明确返回「未配置」，不会静默降级成关键词检索。
    api-key: ${DASHSCOPE_API_KEY:}
    # 嵌入模型（与 application.yml 一致；更换模型必须重建全部向量）
    embedding-model-name: text-embedding-v4
    # 嵌入向量维度
    embedding-dimensions: 1024
  vector:
    # 向量维度（需与 dashscope.embedding-dimensions 一致）
    dimensions: 1024
    # pgvector 持久化配置（默认复用主数据源配置）
    pgvector:
      jdbc-url: ${BANK_DB_URL:jdbc:postgresql://localhost:5432/bank_risk_db}
      username: ${BANK_DB_USERNAME:postgres}
      password: ${BANK_DB_PASSWORD:123456}
      schema: public
      table-name: ai_knowledge_store
  # Nacos Skill Registry（3.2+ 提供 Skill 管理中心；关闭时仅使用本地 SKILL.md）
  nacos:
    # 是否启用 Nacos Skill 自动下载与发布
    enabled: ${NACOS_ENABLED:false}
    # Nacos 服务器地址
    server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
    # 命名空间
    namespace: ${NACOS_NAMESPACE:public}
    # 鉴权（如果开启了 Nacos 鉴权）
    username: ${NACOS_USERNAME:}
    password: ${NACOS_PASSWORD:}

# 天气 API（和风天气，免费注册 https://dev.qweather.com）
qweather:
  # 【选填】和风天气 API Key
  api-key: ${QWEATHER_API_KEY:}
  base-url: https://devapi.qweather.com/v7
  geo-url: https://geoapi.qweather.com/v2
  cache-ttl-minutes: 30

# 自定义应用配置
app:
  # 任务内断面计算的并行度（有界 worker 池的线程数）。
  #
  # 这个数与模型侧的 MAX_RUNNING_MODEL_CASE_NUM 是一对，必须一起调：
  #   需要的模型槽位 ≈ parallelism × 每断面稳态 case 数（约 7；首个断面 10）
  #   4 × 7 = 28  ⇒  模型侧设 32（留约 14% 余量给单断面重算与报告出图抢槽）
  #
  # 真正的硬上限是 CPU：每个模型 case 是独立子进程、基本单线程。
  #   28 逻辑核 ÷ 7 ≈ 4 路 —— 再多只是让子进程互相抢核，总时长不会更短。
  # 内存通常不是瓶颈：40 个槽位里只有 parallelism 个是读整幅 DEM 的重进程，
  # 其余都是百兆级的数值查表 case。
  section:
    parallelism: ${APP_SECTION_PARALLELISM:4}

  model-service:
    base-url: http://localhost:8088
    default-model-api: /v0/mi/risk-level
    connect-timeout: 5s
    read-timeout: 600s

  kafka:
    enabled: ${KAFKA_ENABLED:false}
    task-topic: ${KAFKA_TASK_TOPIC:bank.model.task}
    result-topic: ${KAFKA_RESULT_TOPIC:bank.model.result.v1}
    result-dlt-topic: ${KAFKA_RESULT_DLT_TOPIC:bank.model.result.dlt.v1}
    terrain-bucket: ${KAFKA_TERRAIN_BUCKET:yangtze-bank-warning-system}

  # AI 智能体模块配置
  ai:
    # 知识库检索（RAG 阶段 1 收口 / 阶段 2 公共可见性 + 留痕）：参数集中外置，全部可用 RAG_* 环境变量覆盖。
    # 阶段 2 需先手动执行 migration/V16__rag_phase2_public_and_traces.sql（加 is_public 列），
    # 未执行时可临时设 public-knowledge-enabled=false 让代码不引用该列。
    # 回滚：permission-filter-enabled=false 关闭权限过滤；trace-enabled=false 不写留痕；
    #       enabled=false 关闭检索（明确报错）。
    # 主要开关：RAG_ENABLED / RAG_PERMISSION_FILTER / RAG_PUBLIC_KNOWLEDGE / RAG_TRACE_ENABLED /
    #          RAG_CHAT_TOP_K / RAG_TOOL_TOP_K / RAG_SEARCH_TOP_K /
    #          RAG_SCORE_THRESHOLD / RAG_RETRIEVE_TIMEOUT_MS / RAG_SSE_TIMEOUT_MS /
    #          RAG_HYBRID_ENABLED / RAG_RERANK_ENABLED / RAG_RECALL_FLOOR（阶段 5，默认均开启）
    rag:
      enabled: ${RAG_ENABLED:true}
      permission-filter-enabled: ${RAG_PERMISSION_FILTER:true}
      public-knowledge-enabled: ${RAG_PUBLIC_KNOWLEDGE:true}
      trace-enabled: ${RAG_TRACE_ENABLED:true}
      chat-top-k: ${RAG_CHAT_TOP_K:3}
      tool-top-k: ${RAG_TOOL_TOP_K:5}
      search-top-k: ${RAG_SEARCH_TOP_K:5}
      # 纯向量档的最终门槛；混合/精排档下改由 recall-floor + 精排门槛接管（见 RagThresholdPolicy）。
      score-threshold: ${RAG_SCORE_THRESHOLD:0.4}
      candidate-expansion: ${RAG_CANDIDATE_EXPANSION:5}
      retrieve-timeout-ms: ${RAG_RETRIEVE_TIMEOUT_MS:15000}
      sse-timeout-ms: ${RAG_SSE_TIMEOUT_MS:600000}
      # 阶段 5：混合/精排档下向量路的「召回底线」。0 = 不设底线，只受候选条数限制。
      # 为什么不再用 0.4：那个数是「最终答案合不合格」的标准，被用在粗筛上会切掉真答案
      # （实测有真答案落在 0.3953，还没进融合就被淘汰）。粗筛的职责是「别漏」，不是「别错」。
      recall-floor: ${RAG_RECALL_FLOOR:0.0}
      # 阶段 5：查询改写（全角/罗马数字归一化 + 领域同义词，仅作用于关键词路）。默认关闭。
      # 词表在 QueryReformulator，只收本项目语料里核对过的对应关系（Zb=滩槽高差 等），
      # 不做通用同义词库。开不开由 SparseOnlyEvalCli --rewrite 的 Recall/MRR 对照决定
      # （门槛：Recall@5 +2pp 且没有任何一题从命中退化为空），不凭感觉开。
      rewrite-enabled: ${RAG_REWRITE_ENABLED:false}
      rewrite-max-extra-terms: ${RAG_REWRITE_MAX_EXTRA_TERMS:6}
      # 阶段 5 混合检索（dense 向量 + sparse 关键词 → RRF）。默认开启。
      # 依据：同一份 52 题考卷、topK=5，dense 0.6842/0.5570/0.5899 →
      #      hybrid 0.7895/0.5921/0.6432 → hybrid+rerank 0.8421/0.7368/0.7644
      #      （Recall@5 / MRR / nDCG@5，见 reports/rag-eval-p4-hybridrerank.md）。
      # 打开前提：① 手动执行 migration/V19__rag_chinese_search_text.sql 并跑过 SearchTextBackfillCli；
      #          ② 知识库有多个不同 doc_id（只有一篇时两路只能召回同一份，融合无差别）。
      # 回滚：改 false 即退回纯向量档，此时 score-threshold 重新成为最终门槛。
      hybrid-enabled: ${RAG_HYBRID_ENABLED:true}
      hybrid-sparse-top-k: ${RAG_HYBRID_SPARSE_TOP_K:20}
      hybrid-rrf-k: ${RAG_HYBRID_RRF_K:60}
      hybrid-max-anchors: ${RAG_HYBRID_MAX_ANCHORS:8}
      # 阶段 8：两路 RRF 权重。默认 1.0/1.0，与阶段 5 的等权实现逐位一致，不改就不影响线上。
      # 为什么要权重：向量路衡量语义相近、关键词路衡量字面命中，两路可靠度在中文长文档场景并不对等。
      # 取值必须由离线评测的格点搜索决定（RagEvalCli --rrf-dense-weight/--rrf-sparse-weight），
      # 不要凭感觉设。sparse-weight=0 等价于关闭关键词路。
      hybrid-dense-weight: ${RAG_HYBRID_DENSE_WEIGHT:1.0}
      hybrid-sparse-weight: ${RAG_HYBRID_SPARSE_WEIGHT:1.0}
      # 融合前的候选池。0 = 沿用 limit × candidate-expansion 的旧逻辑。
      # 默认 30：与精排池对齐，让 RRF 与 rerank 两边看到同一批候选；上限 100，配大了自动夹。
      hybrid-candidate-pool: ${RAG_HYBRID_CANDIDATE_POOL:30}
      # 阶段 3：中文关键词路（jieba 分词 + search_text 上的 tsvector 倒排索引）。
      # 只作用于混合检索的第二路，sparse 结果按 ts_rank_cd 排序后交给 RRF。
      # 打开 hybrid-enabled 之前必须先执行 migration/V19__rag_chinese_search_text.sql
      # 并对存量文档跑一次 SearchTextBackfillCli，否则 search_text 为 NULL 的行不参与这一路
      # （仍能被向量路与 ASCII 锚点召回，不会丢）。
      # 实测（52 题考卷、单路 topK=5、不联网）：只认锚点时 Recall 0.4474 / MRR 0.3333，
      # 加中文词项后 0.6842 / 0.5219，18 题新增召回、0 题退化为空。
      chinese-keyword-enabled: ${RAG_CHINESE_KEYWORD_ENABLED:true}
      # 单次查询最多用多少个中文词项。长问句切出二三十个词全塞进去会拖慢且引入噪声。
      chinese-keyword-max-terms: ${RAG_CHINESE_KEYWORD_MAX_TERMS:12}
      # 阶段 6：把「谁能看哪些行」写进向量检索 SQL 的 WHERE（security trimming）。
      # 打开后无权正文不再进入 JVM，普通用户能稳定拿满 topK，每次检索少一条可见集合查询。
      # 关闭即退回 SDK search() + Java 集合过滤，行为与阶段 4 逐字一致（应急回滚用）。
      # 管理员视角两种模式结果应完全相同：RagEvalCli --jdbc（关）与 --sql-filter（开）对照。
      # 注意：WHERE 加在 ANN 查询上会触发 filtered ANN，数据量上来后需 EXPLAIN 复核计划形状。
      sql-permission-filter-enabled: ${RAG_SQL_PERMISSION_FILTER:true}
      # 阶段 7：入库侧批量嵌入。默认关闭 —— 关闭时 addDocuments 走原来的「逐段 embed + block」
      # 循环，线上行为逐字不变。打开后按 batch-size 切片、batch-concurrency 路并发。
      # 对拍实测（text-embedding-v4，BatchEmbeddingParityTest）：
      #   同路径重复调用差 0.0e+00；embed() vs texts[1] 差 0.0e+00；
      #   texts[1] vs texts[4] 差 1.5e-4~4.8e-4、余弦 0.9999987。
      #   ⇒ 数值差只来自「同批有邻居」，与走哪个接口无关。于是两档配置即可切换：
      #   · 零差异档：batch-size=1 + batch-concurrency=4（请求数不变，耗时约 1/4）
      #   · 高吞吐档：batch-size=10 + batch-concurrency=4（请求数 100→10，接受 1e-4 数值差）
      # batch-size 上限 10 是 DashScope text-embedding-v4 的硬限制，配大了直接 400，代码里会硬夹。
      # ingest-budget-ms 是「一次上传所有批加起来」的上限，防止每批都没超时、总和却超掉反代超时。
      batch-embedding-enabled: ${RAG_BATCH_EMBEDDING_ENABLED:false}
      batch-size: ${RAG_BATCH_SIZE:10}
      batch-concurrency: ${RAG_BATCH_CONCURRENCY:4}
      batch-timeout-ms: ${RAG_BATCH_TIMEOUT_MS:30000}
      ingest-budget-ms: ${RAG_INGEST_BUDGET_MS:180000}
      # 相邻 chunk 的重叠字数，取值 0 ~ 250（半块），默认 50（块长的 10%）。
      # 定值方法：业界按块长比例定重叠，再按文档类型取档 —— 通用 10%、技术文档与代码
      #      10~15%、长篇报告与法律 15~20%。本项目块长 500、语料以技术报告为主，取下限。
      # 实测（217 块 / 9 万字真实语料）：
      #      重叠 0  → 217 块，9.0 万字
      #      重叠 50 → 239 块（+10%），10.1 万字（+12%）
      #      重叠 100 → 270 块（+24%），11.3 万字（+25%）
      # 取 50 而非 100：块尾被真正切断的句子（残句 >60 字）仅 9 条、p90 为 48 字，
      #      50 字已覆盖九成断句；再加的部分主要作用于跨块上下文衔接，属答案忠实度收益，
      #      需生成层评估才能验证，在验证手段到位前不预付双倍成本。
      # 注意：改动本值属于「切分口径变更」，新段与旧段不可直接比较，需重灌已有文档。
      chunk-overlap: ${RAG_CHUNK_OVERLAP:50}
      # 阶段 8：rerank 二阶段精排（DashScope gte-rerank-v2）。默认开启（阶段 5 合闸）。
      # 关闭时检索路径一行都不多走，结果退回阶段 7 的粗排顺序（应急回滚）。
      # 打开后：粗召回取 rerank-candidate-pool 条 → cross-encoder 逐对打分 → 截到 topK。
      # 代价是每次检索多一次外部往返（典型 100~300ms）与按量计费，所以候选池别开太大。
      # 安全：rerank 会把候选正文发给外部服务，因此它必须发生在权限过滤之后——
      #      代码里固定在 applyPermissionFilter / SQL 内过滤之后调用，不要往前挪。
      # rerank-score-threshold 默认 0（不过滤）：rerank 分数的分布要先用评测标定，
      # 没标定就给阈值等于凭空造一个不可解释的口径。标定后再配。
      # rerank-timeout-ms 必须有值：精排是同步调用，retrieve-timeout-ms 包不住它，
      # 没有超时就是「一次外部抖动 = 一次全站卡死」。
      rerank-enabled: ${RAG_RERANK_ENABLED:true}
      rerank-model: ${RAG_RERANK_MODEL:gte-rerank-v2}
      rerank-candidate-pool: ${RAG_RERANK_CANDIDATE_POOL:30}
      # 0.15 是标定值：真离题题精排 top1 = 0.1434 / 0.0061，命中题最低 top1 = 0.1583，
      # 门槛取两者之间。实测 Recall 不变（0.8421），Precision 0.4890→0.5197，拒答通过率 0→0.5；
      # 抬到 0.20 会切掉真答案（Recall 0.8421→0.5263）。换语料需重新标定。
      rerank-score-threshold: ${RAG_RERANK_SCORE_THRESHOLD:0.15}
      rerank-timeout-ms: ${RAG_RERANK_TIMEOUT_MS:3000}
      # 报告轨 RAG：Step 6 撰写前固定预检索一次，把命中的口径作为提示词的一段输入。
      # 默认关闭 —— 库里目前只有 4 段 BMS.docx（内部算法说明，不是判定标准），
      # 打开会把不可信文本注入正式交付物。阶段 3 灌入可信冻结口径后再置 true。
      report-enabled: ${RAG_REPORT_ENABLED:false}
      report-top-k: ${RAG_REPORT_TOP_K:3}
      # 固定 query 常量：不要按任务动态拼，否则同任务两次生成的检索结果可能不同。
      report-query: ${RAG_REPORT_QUERY:崩岸风险等级判定阈值 指标定义 权重 等级划分 风险等级}
    skill:
      # Skill 脚本物化缓存根目录（启动时把所有 skill 的 resources 物化到这里）
      # <cache-dir>/<skill-name>/scripts/<file>
      cache-dir: ${user.dir}/.skills-cache
      # Skill 安全校验（阶段一）
      verify:
        # 是否启用完整性校验与静态扫描（关闭时仅保留路径防逃逸）
        enabled: ${SKILL_VERIFY_ENABLED:true}
        # HMAC-SHA256 签名密钥（上传/下载 skill zip 时生成与校验清单用）
        hmac-secret: ${SKILL_HMAC_SECRET:}
        # 静态扫描发现危险 import 时：true=拒绝，false=仅告警
        fail-on-violation: ${SKILL_VERIFY_FAIL_ON_VIOLATION:true}
        # 危险模块黑名单（可覆盖默认值）
        forbidden-imports: [ctypes, multiprocessing, socket, subprocess, urllib, http, ftplib, telnetlib, ftputil, paramiko, shutil]
      # Skill 执行沙箱（阶段二）
      sandbox:
        # off=关闭沙箱（阶段一原行为）；process=进程级软沙箱（默认）；docker=容器级硬沙箱（生产建议）
        mode: ${SKILL_SANDBOX_MODE:process}
        # 单次执行超时（秒），超时后强杀整棵进程树
        timeout-seconds: ${SKILL_SANDBOX_TIMEOUT_SECONDS:120}
        # stdout/stderr 最大捕获字节数，超出部分丢弃并标记截断（防输出洪泛）
        max-output-bytes: ${SKILL_SANDBOX_MAX_OUTPUT_BYTES:1048576}
        # 脚本内存上限（MB，POSIX rlimit；Windows 下降级为仅超时+输出上限）
        memory-mb: ${SKILL_SANDBOX_MEMORY_MB:512}
        # CPU 时间上限（秒，POSIX rlimit）
        cpu-seconds: ${SKILL_SANDBOX_CPU_SECONDS:30}
        # docker 模式：容器内进程数上限 / CPU 配额
        pids-limit: ${SKILL_SANDBOX_PIDS_LIMIT:64}
        cpus: ${SKILL_SANDBOX_CPUS:0.5}
        # docker 模式：镜像名（需预置 Python 及 skill 依赖）
        docker-image: ${SKILL_SANDBOX_DOCKER_IMAGE:}
        # 子进程环境变量白名单（其余一律不继承，防 os.environ 偷取宿主密钥）
        env-allowlist: [PATH, SYSTEMROOT, WINDIR, COMSPEC, PATHEXT, LANG, LC_ALL, PYTHONIOENCODING]
      # Skill 治理闭环（阶段三）
      governance:
        # 是否启用治理（关闭时跳过审批/版本/熔断检查，输出契约校验仍生效）
        enabled: ${SKILL_GOVERNANCE_ENABLED:true}
        # 全局熔断：true 时所有动态 skill 脚本一律拒绝执行
        kill-switch: ${SKILL_GOVERNANCE_KILL_SWITCH:false}
        # 版本批准清单（skill@version），为空表示不限制版本，但仍校验权限审批
        allowed-versions: []
        # 隔离清单（skill@version），命中即拒绝执行（应急下架）
        quarantined-versions: []
        # 权限未审批时：true=拒绝执行，false=仅告警放行（灰度观察期）
        fail-on-unapproved-permission: ${SKILL_GOVERNANCE_FAIL_ON_UNAPPROVED:true}
    pdf:
      # 兼容旧路径：仅当 cache 里找不到时回退到这里
      fallback-scripts-dir: ${user.dir}/src/main/resources/skills/pdf/scripts
    # 可视化脚本配置
    visualization:
      # 脚本目录（bank-model-server 路径）
      script-dir: ../bank-model-server
      # 可视化输出目录
      output-dir: visualization/output

  # CORS 白名单：前端 dev server / 生产站点来源，逗号分隔，支持 Spring origin pattern
  # （http://localhost:[*] 表示「本机任意端口」）。
  # ⚠ 生产部署务必用环境变量覆盖为精确域名；白名单不命中时后端在 Controller
  #   **之前**返回 403 Invalid CORS request，日志不留痕，排查成本极高。
  # 注意：原先本文件里还有一个重复的顶层 `app:` 只写 cors，YAML 后者覆盖前者，
  #      会把上面 model-service / kafka / ai / section 全部冲掉，故合并至此。
  cors:
    allowed-origins: ${APP_CORS_ALLOWED_ORIGINS:http://localhost:[*],http://127.0.0.1:[*]}

# MyBatis 配置
mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  type-aliases-package: com.yangtze.bankwarning.domain.po
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

# 安全配置
security:
  jwt:
    # 【重要】生产环境必须通过环境变量 JWT_SECRET 设置真实密钥
    # 密钥长度至少32字节（256位），建议使用随机生成的密钥
    # 生成密钥命令：openssl rand -base64 32
    secret: ${JWT_SECRET:}
    expiration: 86400000  # 24小时
    refreshExpiration: 604800000  # 7天
  
  sms:
    enabled: ${SMS_ENABLED:false}
    provider: ${SMS_PROVIDER:aliyun}
    access-key: ${SMS_ACCESS_KEY:}
    access-secret: ${SMS_ACCESS_SECRET:}
    sign-name: ${SMS_SIGN_NAME:长江崩岸预警系统}
    template-code: ${SMS_TEMPLATE_CODE:}

# 集群模式（多实例部署）开关。
# false = 内存中断表 + 进程内锁，单实例语义，零外部依赖（默认）；
# true  = Redis 中断表 + Redisson 分布式读写锁，请求落到任何实例都能正确判断
#         「谁在跑」「谁在算这条断面」，并且抢不到锁的请求立刻 409。
# 两个实例的 instance-id 不能相同，否则所有权判断会互相覆盖。
bw:
  cluster:
    enabled: ${BW_CLUSTER_ENABLED:false}
    instance-id: ${BW_INSTANCE_ID:}
    lease-ttl: ${BW_CLUSTER_LEASE_TTL:60s}
    cancel-ttl: ${BW_CLUSTER_CANCEL_TTL:12h}
    # 分布式锁的 watchdog 基准 TTL：Redisson 会在它的 1/3 处自动续期。
    # 它同时决定「实例猝死后锁多久自动失效」，默认 30s 与 Redisson 官方一致。
    # ⚠ 千万不要改成「任务预计运行时长」那种小值，那是把 watchdog 当 leaseTime 用。
    lock-watchdog-timeout: ${BW_CLUSTER_LOCK_WATCHDOG:30s}
