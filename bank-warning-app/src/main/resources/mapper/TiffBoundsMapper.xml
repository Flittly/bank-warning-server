<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangtze.bankwarning.mapper.TiffBoundsMapper">

    <resultMap id="TiffBoundsResultMap" type="com.yangtze.bankwarning.domain.po.TiffBoundsPO">
        <id property="id" column="id"/>
        <result property="tiffKey" column="tiff_key"/>
        <result property="regionCode" column="region_code"/>
        <result property="year" column="year"/>
        <result property="timepoint" column="timepoint"/>
        <result property="minX" column="min_x"/>
        <result property="minY" column="min_y"/>
        <result property="maxX" column="max_x"/>
        <result property="maxY" column="max_y"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <select id="selectAll" resultMap="TiffBoundsResultMap">
        SELECT * FROM tiff_bounds WHERE (user_id = #{userId} OR #{userId, jdbcType=BIGINT} IS NULL) ORDER BY tiff_key
    </select>

</mapper>
