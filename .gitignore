# 项目排除路径
*.class
/target/
**/target/
/hs_err_pid15300.log
/hs_err_pid30056.log
/demo-example/README_原理说明.md
/demo-example/对比说明.md
/验证单JVM.bat
/bank-warning-app/target/

# 敏感配置文件（包含 API Key、数据库密码等）
bank-warning-app/src/main/resources/application.yml
bank-warning-app/src/main/resources/application-*.yml
!bank-warning-app/src/main/resources/application.yml.example

# 环境变量文件
.idea/
.env
.env.local
.env.*.local

# skill 运行时缓存（框架物化产物，随时可重建）→ 忽略
.skills-cache

# 注意：bank-warning-ai/src/main/resources/skills/ 是 skill 的【源】目录，
# 必须入库。这里曾有一条裸目录忽略规则，把 extract_text.py、word/、
# find-skills/、skill-creator/ 挡在版本库外，导致新机器 clone 后
# resolveScript 找不到脚本、PDF 知识库不可用。
# 源目录里要忽略的只有产物（__pycache__、.venv 等），不是整个目录：
bank-warning-ai/src/main/resources/skills/**/__pycache__/
bank-warning-ai/src/main/resources/skills/**/.venv/
bank-warning-ai/src/main/resources/skills/**/uv.lock

visualization/output

# WorkBuddy 工作区数据（会话记忆、本地技能、缓存等，不入库）
.workbuddy/

# AgentScope 运行时工作区（.agentscope/）
# 框架每次运行都会改写这里的会话记录、MEMORY.md、技能缓存，入了库就是纯 diff 噪音 → 整体忽略。
# 只放行两份"人维护、框架只读不改写"的源资料（注意：反选必须逐级打开父目录，否则 ! 不生效）：
#   AGENTS.md               智能体人设与本地约定；框架只读，缺失时仅打一条 warn，不会重新生成
#   knowledge/KNOWLEDGE.md  每次调用注入 system prompt 的领域知识
/.agentscope/*
!/.agentscope/workspace/
/.agentscope/workspace/*
!/.agentscope/workspace/chat/
/.agentscope/workspace/chat/*
!/.agentscope/workspace/chat/AGENTS.md
!/.agentscope/workspace/chat/knowledge/
/.agentscope/workspace/chat/knowledge/*
!/.agentscope/workspace/chat/knowledge/KNOWLEDGE.md